+    @ActivityCallback
+    private void onSaveFileAsResult(PluginCall call, ActivityResult result) {
+        if (result == null || result.getResultCode() != Activity.RESULT_OK || result.getData() == null) {
+            call.reject("User cancelled");
+            return;
+        }
