+    // than silently dropping it in Downloads the way a browser-style
+    // anchor-download fallback does.
+    @PluginMethod
+    public void saveFileAs(PluginCall call) {
+        String suggestedName = call.getString("suggestedName", "document.md");
+        String mimeType = call.getString("mimeType", "text/markdown");
